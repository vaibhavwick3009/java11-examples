pipeline {
    agent any

    tools {
        maven 'MAVEN_3'
        jdk 'JDK_21'
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/vaibhavwick3009/java11-examples.git'
            }
        }

        stage('Build Maven Project') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Deploy to Tomcat 11') {
            steps {
                deploy adapters: [
                    tomcat10(
                        credentialsId: 'tomcat',
                        path: '',
                        url: 'http://http://127.0.0.1:8081'
                    )
                ],
                contextPath: 'myapp',
                war: '**/target/*.war'
            }
        }
    }

    post {
        success {
            echo 'Application deployed successfully to Tomcat!'
        }
        failure {
            echo 'Deployment failed!'
        }
    }
}
